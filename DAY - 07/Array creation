package day07;

import java.util.Scanner;

public class Array_creations {
    public static void main(String[] args) {
        Scanner k = new Scanner(System.in);
        String[]a=new String[5];

        for(int i=0;i<5;i++){
            String g=k.next();
            a[i]=g;
        }
        for(String j:a){
            System.out.println(j);
        }


    }
}
